<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 outlined field: violet when it holds a pairing link (state_activated) or has focus -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <stroke android:width="2dp" android:color="@color/sheet_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/sheet_muted" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
