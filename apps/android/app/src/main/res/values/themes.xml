<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.App" parent="android:Theme.Material.Light.NoActionBar" />
    <style name="Base.Dialog" parent="android:Theme.Material.Light.Dialog.Alert" />
    <bool name="light_bars">true</bool>

    <style name="Theme.BubbleAI" parent="Base.App">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/ink</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorHighlight">#557A5BDC</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:alertDialogTheme">@style/Theme.BubbleAI.Dialog</item>
        <item name="android:dialogTheme">@style/Theme.BubbleAI.Dialog</item>
    </style>

    <!-- Material 3 dialogs in Bubble AI's colors: rounded floating surface, ink text buttons in sentence case,
         the violet only for the selected choice. Also used by web pages' native dropdowns. -->
    <style name="Theme.BubbleAI.Dialog" parent="Base.Dialog">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:colorBackground">@color/float_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:textColorAlertDialogListItem">@color/ink</item>
        <item name="android:windowTitleStyle">@style/DialogTitle</item>
        <item name="android:buttonBarButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/DialogButton.Positive</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/DialogButton</item>
        <item name="android:buttonBarNeutralButtonStyle">@style/DialogButton</item>
        <item name="android:listDividerAlertDialog">@null</item>    </style>

    <style name="DialogTitle" parent="android:TextAppearance.Material.DialogWindowTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DialogButton" parent="android:Widget.Material.Button.Borderless">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minWidth">64dp</item>
    </style>

    <style name="DialogButton.Positive">
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">26sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Small">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Primary" parent="android:Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">50dp</item>
        <item name="android:background">@drawable/pill</item>
        <item name="android:textColor">@color/on_ink</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Quiet" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
