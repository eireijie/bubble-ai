---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found" description="This page doesn't exist.">
  <div class="wrap lost">
    <img class="float" src="/favicon.svg" alt="" width="88" height="88" />
    <h1>Nothing here</h1>
    <p>That page doesn't exist, or it moved.</p>
    <a class="btn btn-primary" href="/">Go to the home page</a>
  </div>
</Base>

<style>
  .lost {
    text-align: center;
    padding-top: 80px;
  }
  .lost h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    margin-top: 20px;
  }
  .lost p {
    color: var(--muted);
  }
</style>
