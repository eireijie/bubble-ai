<?xml version="1.0" encoding="utf-8"?>
<!-- The first screen when the phone isn't paired (canvas "Phone welcome", round 2: Calm background, Pill button).
     The bubbles and the big bubble are one view behind the words; the words sit under the big bubble,
     placed in code at 42% of the screen + 118dp. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/welcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/welcome_ground">

    <ai.wisp.android.BubbleFieldView
        android:id="@+id/field"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/words"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="-0.025"
            android:text="@string/welcome_name"
            android:textColor="@color/welcome_word"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/welcome_tagline"
            android:textColor="@color/welcome_tag"
            android:textSize="16.5sp" />

        <TextView
            android:id="@+id/error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="@color/bad"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/scan"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:background="@drawable/pill_welcome"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/scanIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_qr"
                android:tint="@color/welcome_button_text" />

            <TextView
                android:id="@+id/scanText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="-0.01"
                android:text="@string/welcome_scan"
                android:textColor="@color/welcome_button_text"
                android:textSize="18sp" />
        </LinearLayout>

        <Button
            android:id="@+id/typeLink"
            style="@style/Quiet"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/welcome_link"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>
